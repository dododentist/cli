{
  "name": "dododentist",
  "version": "1.1.0",
  "private": false,
  "description": "DodoDentist CLI — manage the patients, appointments, treatments, invoices and payments of your dental clinic from the terminal",
  "license": "Apache-2.0",
  "repository": "github:dododentist/cli",
  "homepage": "https://www.dododentist.com/",
  "author": "DodoDentist",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "bin": {
    "dododentist": "./bin/dododentist.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "develop": "node index.js",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public",
    "publish:repo": "node scripts/publishCli.mjs",
    "test": "vitest run",
    "test:smoke": "npm run build && node scripts/smoke.js"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "keywords": [
    "dental",
    "dentist",
    "clinic",
    "appointments",
    "practice-management",
    "cli"
  ],
  "dependencies": {
    "commander": "8.3.0",
    "inquirer": "8.2.5",
    "node-localstorage": "2.2.1"
  },
  "devDependencies": {
    "@monorepool/agentfirst": "0.0.0",
    "@monorepool/root": "0.0.0",
    "esbuild": "0.25.4",
    "vitest": "catalog:"
  }
}
